{
  "name": "monad",
  "description": "Daemon-first agent team runtime with headless architecture.",
  "version": "0.1.6",
  "author": "Monadix Labs, Inc.",
  "bugs": {
    "url": "https://github.com/Monadix-AI/monad/issues"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/format": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@types/bun": "^1.3.14",
    "commitizen": "^4.3.2",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "mint": "4.2.812",
    "open-cli": "9.0.0",
    "rimraf": "6.1.3",
    "rulesync": "^16.14.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "wait-on": "9.1.0"
  },
  "homepage": "https://github.com/Monadix-AI/monad#readme",
  "license": "MIT",
  "overrides": {
    "dompurify": "3.4.13",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.5.0",
    "mermaid": "11.16.1",
    "postcss": "^8.5.26"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monadix-AI/monad.git"
  },
  "scripts": {
    "agents:sync": "rulesync generate",
    "build": "turbo run build",
    "dev": "bun run generate && turbo watch generate @monad/monad#start:dev @monad/monad#devtools @monad/web#start:dev @monad/ui#storybook @monad/web#storybook",
    "dev:open-storybooks": "wait-on http-get://127.0.0.1:${WEB_STORYBOOK_PORT:-6006} http-get://127.0.0.1:${UI_STORYBOOK_PORT:-6007} && open-cli http://127.0.0.1:${WEB_STORYBOOK_PORT:-6006} && open-cli http://127.0.0.1:${UI_STORYBOOK_PORT:-6007}",
    "generate": "turbo run generate",
    "lint": "bun scripts/quiet-run.ts biome check --write --error-on-warnings",
    "postinstall": "bun run scripts/dev-init.ts --skip-generate",
    "test": "bun scripts/quiet-run.ts bun run test:raw",
    "test:e2e": "bun scripts/quiet-run.ts bun run test:e2e:raw",
    "test:e2e:raw": "turbo run test:e2e --output-logs=errors-only",
    "test:raw": "bun run test:unit:raw && bun run test:e2e:raw",
    "test:unit": "bun scripts/quiet-run.ts bun run test:unit:raw",
    "test:unit:raw": "turbo run test --output-logs=errors-only && bun scripts/bun-test.ts scripts/test/unit/ --only-failures",
    "typecheck": "bun scripts/quiet-run.ts bun run typecheck:raw",
    "typecheck:raw": "bun run generate && tsc --noEmit && turbo run typecheck --only --output-logs=errors-only",
    "typecheck:staged": "turbo run generate --force --output-logs=errors-only && turbo run typecheck --filter=[HEAD] --output-logs=errors-only"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
