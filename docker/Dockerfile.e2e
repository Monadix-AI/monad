#
# Disposable build-verify + e2e pipeline — nothing touches the host.
#
#   Stage 1 (builder): compile the single `monad` binary (+ embedded SPA) into a tarball
#   Stage 2 (runner):  extract the test tarball into /opt/monad in a fresh Debian image, then boot
#                      daemon + web (offline mock model) and run the full e2e (scripts/e2e.sh)
#
# Platform defaults to the host's native architecture (fast, no QEMU). Override for CI:
#   docker build --platform linux/amd64 -f docker/Dockerfile.e2e .
#
# Usage:  mise run docker:test:e2e   |   mise run docker:shell

# ── Stage 1: build ────────────────────────────────────────────────────────────

FROM oven/bun:1.4.1@sha256:9e123d5fc069e29d519fd4c981afb61b8542ac80274771961136db1e4538d53e AS builder
WORKDIR /workspace

# Layer-cache bun install: manifests first, full source second.
COPY bun.lock package.json turbo.jsonc ./
COPY --parents apps/*/package.json clients/*/package.json packages/*/package.json ./

RUN bun install --ignore-scripts --registry=https://registry.npmmirror.com --network-concurrency 4 \
  || bun install --ignore-scripts --registry=https://registry.npmmirror.com --network-concurrency 1 \
  || bun install --ignore-scripts --network-concurrency 1
RUN apt-get update \
  && apt-get install -y --no-install-recommends binutils gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
  && rm -rf /var/lib/apt/lists/*
COPY . .
RUN aarch64-linux-gnu-gcc -O2 -s -static \
  -o /tmp/monad-sandbox-launcher apps/monad/native/sandbox-launcher/main.c
RUN bun run scripts/build-release.ts

# ── Stage 2: install + e2e ─────────────────────────────────────────────────────

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runner
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl jq \
  && rm -rf /var/lib/apt/lists/*

COPY scripts/test/e2e.sh       /e2e.sh
COPY scripts/test/e2e-live.sh  /e2e-live.sh
RUN chmod +x /e2e.sh /e2e-live.sh
COPY --from=builder /workspace/dist/monad-*-linux-*.tar.gz /dist/

# Extract the test binary. Production installation is covered by the dist installer matrix in
# .github/workflows/release.yml.
RUN set -e; \
  tarball=$(ls /dist/monad-*-linux-*.tar.gz | head -1); \
  mkdir -p /opt/monad/local-bin /opt/monad/home /tmp/monad-release; \
  tar -xzf "$tarball" -C /tmp/monad-release; \
  cp /tmp/monad-release/*/bin/monad /opt/monad/local-bin/monad; \
  chmod +x /opt/monad/local-bin/monad

# Default command boots services + runs the full e2e against the installed binary.
ENV MONAD_BIN=/opt/monad/local-bin/monad MONAD_HOME=/opt/monad/e2e-home DPORT=52749 WPORT=3000
CMD ["/e2e.sh"]

# The live, real-model e2e (/e2e-live.sh) is intentionally NOT a build-time RUN: it needs network
# egress + a secret API key, so it runs at `docker run` time with the key injected then —
# never baked into a layer. See `mise run docker:test:e2e:live`.

# ── Stage 3: verify ────────────────────────────────────────────────────────────
# Build-time gate: `docker build --target verify` fails if e2e fails, so the build itself
# is the verification. `mise run docker:shell` targets `runner` instead (no gate) for manual poking.
FROM runner AS verify
RUN /e2e.sh
