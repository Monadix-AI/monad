#
# Multi-stage test pipeline — nothing touches the host.
#
#   Stage 1 (builder): compile all binaries + Next.js standalone
#   Stage 2 (tester):  extract the test artifact in a fresh Debian environment + smoke tests
#
# Platform defaults to the host's native architecture (fast, no QEMU emulation).
# Override for CI:  docker build --platform linux/amd64 ...
#
# Usage:
#   mise run docker:test:install
#   PLATFORM=linux/amd64 mise run docker:test:install   # x64 cross-compile on Apple Silicon (slow)

# ── Stage 1: build ────────────────────────────────────────────────────────────

FROM oven/bun:1.4.1@sha256:9e123d5fc069e29d519fd4c981afb61b8542ac80274771961136db1e4538d53e AS builder

WORKDIR /workspace

# Layer-cache bun install: copy manifests first, full source second.
COPY bun.lock package.json turbo.jsonc ./
COPY --parents apps/*/package.json clients/*/package.json packages/*/package.json ./

RUN bun install --ignore-scripts --registry=https://registry.npmmirror.com --network-concurrency 4 \
  || bun install --ignore-scripts --registry=https://registry.npmmirror.com --network-concurrency 1 \
  || bun install --ignore-scripts --network-concurrency 1

COPY . .

RUN bun run scripts/build-release.ts

# ── Stage 2: test ─────────────────────────────────────────────────────────────

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS tester

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/dist/monad-*-linux-*.tar.gz /dist/

# Extract whichever test tarball was built. The production dist installers have their own native
# smoke-test matrix in .github/workflows/release.yml.
RUN set -e; \
  tarball=$(ls /dist/monad-*-linux-*.tar.gz | head -1); \
  mkdir -p /opt/monad/local-bin /opt/monad/home /tmp/monad-release; \
  tar -xzf "$tarball" -C /tmp/monad-release; \
  cp /tmp/monad-release/*/bin/monad /opt/monad/local-bin/monad; \
  chmod +x /opt/monad/local-bin/monad

# ── Smoke tests ────────────────────────────────────────────────────────────────

RUN echo "=== monad CLI ===" \
  && /opt/monad/local-bin/monad --help | head -8

RUN echo "=== installed (one binary + name-symlinks) ===" \
  && ls -lh /opt/monad/local-bin/

RUN echo "=== monad home (isolated) ===" \
  && ls /opt/monad/home/

RUN echo "All checks passed."
