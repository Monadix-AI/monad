
FROM oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS test

WORKDIR /workspace

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git unzip zip \
  && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.bun/bin:${PATH}"

RUN bun install --global \
  @openai/codex@0.145.0 \
  @anthropic-ai/claude-code@2.1.220 \
  @google/gemini-cli@0.49.0 \
  @qwen-code/qwen-code@0.19.6

COPY bun.lock package.json turbo.jsonc ./
COPY --parents apps/*/package.json clients/*/package.json packages/*/package.json ./

RUN bun install --ignore-scripts --registry=https://registry.npmmirror.com --network-concurrency 4 \
  || bun install --ignore-scripts --registry=https://registry.npmmirror.com --network-concurrency 1 \
  || bun install --ignore-scripts --network-concurrency 1

COPY . .

# Generated build inputs are gitignored, so this image never receives them — the suite runs raw
# `bun test` rather than a package script that would prepare them.
RUN bun run generate

ENV NODE_ENV=test \
    MONAD_TEST_CONTAINER_DEPS=1 \
    NO_PROXY=* \
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" \
    http_proxy="" https_proxy="" all_proxy=""

WORKDIR /workspace/apps/monad

RUN bun ../../scripts/bun-test.ts test/e2e/atom-module.container.linux.test.ts --only-failures
