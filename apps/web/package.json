    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-generator": "1.167.24",
    "@tanstack/router-plugin": "^1.168.26",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "postcss": "^8.5.26",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "exports": {
    "./server": "./server/index.ts"
  },
  "imports": {
    "#/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx",
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*/index.ts",
      "./*/index.tsx"
    ]
  },
  "private": true,
  "scripts": {
    "build": "bunx --bun vite build",
    "build-storybook": "storybook build",
    "generate": "bun run scripts/generate-route-tree.ts",
    "start": "bunx --bun vite preview --host 0.0.0.0 --port ${WEB_PORT:-3000}",
    "start:dev": "LAUNCH_EDITOR=${LAUNCH_EDITOR:-/usr/local/bin/code} bunx --bun vite --host 0.0.0.0 --port ${WEB_PORT:-3000}",
    "storybook": "storybook dev -p ${WEB_STORYBOOK_PORT:-6006} --no-open",
    "test": "bun ../../scripts/quiet-run.ts bun ../../scripts/bun-test.ts test/unit/ --only-failures",
    "test:e2e": "bun ../../scripts/quiet-run.ts playwright test --reporter=dot",
    "typecheck": "bun ../../scripts/quiet-run.ts tsc --noEmit"
  },
  "type": "module"
}
