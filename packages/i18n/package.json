{
  "name": "@monad/i18n",
  "version": "0.0.0",
  "dependencies": {},
  "devDependencies": {
    "@monad/tsconfig": "workspace:*",
    "@types/bun": "^1.4.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./messages": "./src/messages.ts",
    "./locale-dir": "./src/locale-dir.ts"
  },
  "imports": {
    "#messages": {
      "monad-typecheck": "./src/messages.typecheck.ts",
      "default": "./src/messages.ts"
    },
    "#catalog-types": {
      "monad-typecheck": "./src/catalog-types.typecheck.ts",
      "default": "./src/catalog-types.ts"
    }
  },
  "module": "src/index.ts",
  "private": true,
  "scripts": {
    "generate": "bun ../../scripts/i18n/catalog.ts --write",
    "test": "bun ../../scripts/quiet-run.ts bun ../../scripts/bun-test.ts test/unit/ --only-failures",
    "test:integration": "bun ../../scripts/quiet-run.ts bun ../../scripts/bun-test.ts test/integration/ --only-failures",
    "typecheck": "bun ../../scripts/quiet-run.ts tsc -p tsconfig.typecheck.json --noEmit"
  },
  "sideEffects": false,
  "type": "module"
}
